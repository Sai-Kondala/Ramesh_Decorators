---
interface Props {
  title: string;
  description: string;
  icon: 'mandap' | 'rings' | 'cake' | 'corporate';
  href: string;
}

const { title, description, icon, href } = Astro.props;
---

<a 
  href={href}
  class="group relative flex flex-col justify-between p-6 sm:p-7 bg-ivory rounded-2xl border border-beige/80 hover:border-gold/50 shadow-sm hover:shadow-luxury-hover hover:-translate-y-1 transition-all duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-gold"
>
  <div>
    <!-- Icon Container -->
    <div class="w-14 h-14 rounded-xl bg-beige/40 group-hover:bg-gold/15 flex items-center justify-center text-gold-dark mb-5 transition-colors duration-300">
      {icon === 'mandap' && (
        <svg class="w-8 h-8 text-gold-amber group-hover:scale-105 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 21h18"/>
          <path d="M5 21V9"/>
          <path d="M19 21V9"/>
          <path d="M3 9c0-3.3 4-6 9-6s9 2.7 9 6H3Z"/>
          <path d="M8 9v12"/>
          <path d="M16 9v12"/>
          <circle cx="12" cy="5" r="1" fill="currentColor"/>
        </svg>
      )}

      {icon === 'rings' && (
        <svg class="w-8 h-8 text-gold-amber group-hover:scale-105 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="12" r="5"/>
          <circle cx="15" cy="12" r="5"/>
          <path d="M9 7c1-2 3-3 5-3"/>
        </svg>
      )}

      {icon === 'cake' && (
        <svg class="w-8 h-8 text-gold-amber group-hover:scale-105 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-8a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8"/>
          <path d="M4 16s.5-1 2-1 2.5 2 4 2 2.5-2 4-2 2.5 2 4 2 2-1 2-1"/>
          <path d="M2 21h20"/>
          <path d="M7 8v2"/>
          <path d="M12 8v2"/>
          <path d="M17 8v2"/>
          <path d="M7 4h.01"/>
          <path d="M12 4h.01"/>
          <path d="M17 4h.01"/>
        </svg>
      )}

      {icon === 'corporate' && (
        <svg class="w-8 h-8 text-gold-amber group-hover:scale-105 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
      )}
    </div>

    <!-- Title -->
    <h3 class="font-serif text-xl font-bold text-navy mb-2 group-hover:text-gold-dark transition-colors">
      {title}
    </h3>

    <!-- Description -->
    <p class="font-sans text-sm text-body/90 leading-relaxed">
      {description}
    </p>
  </div>

  <!-- Bottom Arrow indicator -->
  <div class="mt-6 flex items-center justify-end">
    <div class="w-8 h-8 rounded-full border border-beige-dark group-hover:border-gold group-hover:bg-gold/10 flex items-center justify-center text-navy group-hover:text-gold-dark transition-all duration-300">
      <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14" />
        <path d="m12 5 7 7-7 7" />
      </svg>
    </div>
  </div>
</a>
