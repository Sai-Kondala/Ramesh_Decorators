---
---

<section id="about" class="relative py-20 sm:py-28 bg-ivory overflow-hidden border-t border-beige/60">
  
  <!-- Decorative Botanical Leaf Accents in Corners (Matching the reference design) -->
  <div class="absolute left-0 top-1/2 -translate-y-1/2 w-48 sm:w-64 opacity-25 pointer-events-none -translate-x-12">
    <svg viewBox="0 0 200 300" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M10 150 C40 100, 80 80, 140 70 M80 80 C110 50, 150 40, 180 50 M140 70 C160 90, 170 120, 160 150 M100 130 C130 140, 150 170, 140 200 M60 170 C90 190, 110 220, 100 250" stroke="#C18A43" stroke-width="1.5" stroke-linecap="round"/>
      <path d="M80 80 Q105 60 120 75 Q100 95 80 80 Z" fill="#C18A43" opacity="0.3"/>
      <path d="M140 70 Q165 60 175 80 Q150 95 140 70 Z" fill="#C18A43" opacity="0.3"/>
      <path d="M100 130 Q125 120 135 140 Q110 155 100 130 Z" fill="#C18A43" opacity="0.3"/>
      <path d="M60 170 Q85 160 95 180 Q70 195 60 170 Z" fill="#C18A43" opacity="0.3"/>
    </svg>
  </div>

  <div class="absolute right-0 top-1/2 -translate-y-1/2 w-48 sm:w-64 opacity-25 pointer-events-none translate-x-12 rotate-180">
    <svg viewBox="0 0 200 300" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M10 150 C40 100, 80 80, 140 70 M80 80 C110 50, 150 40, 180 50 M140 70 C160 90, 170 120, 160 150 M100 130 C130 140, 150 170, 140 200 M60 170 C90 190, 110 220, 100 250" stroke="#C18A43" stroke-width="1.5" stroke-linecap="round"/>
      <path d="M80 80 Q105 60 120 75 Q100 95 80 80 Z" fill="#C18A43" opacity="0.3"/>
      <path d="M140 70 Q165 60 175 80 Q150 95 140 70 Z" fill="#C18A43" opacity="0.3"/>
      <path d="M100 130 Q125 120 135 140 Q110 155 100 130 Z" fill="#C18A43" opacity="0.3"/>
      <path d="M60 170 Q85 160 95 180 Q70 195 60 170 Z" fill="#C18A43" opacity="0.3"/>
    </svg>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      
      <!-- Left Column: Heading and Description -->
      <div class="lg:col-span-6">
        <p class="font-sans text-xs sm:text-sm font-bold tracking-[0.22em] text-gold-amber uppercase mb-3">
          ABOUT RAMESH DECORATORS
        </p>
        
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-navy leading-tight tracking-tight mb-6">
          Every Detail, <br class="hidden sm:inline"/>
          <span class="italic font-normal text-gold-dark font-serif">Beautifully Designed</span>
        </h2>

        <p class="font-sans text-base sm:text-lg text-body leading-relaxed max-w-xl">
          Ramesh Decorators is dedicated to creating beautiful and unforgettable experiences through exceptional event decoration and planning services. From intimate gatherings to grand weddings, we bring your vision to life with creativity, quality and attention to detail.
        </p>
      </div>

      <!-- Right Column: 4 Key Pillars (Matching the reference layout) -->
      <div class="lg:col-span-6">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 sm:gap-4 lg:gap-6">
          
          <!-- Pillar 1: Creative Decor Designs -->
          <div class="flex flex-col items-center text-center p-4 rounded-xl bg-ivory-light border border-beige/80 hover:border-gold/40 shadow-sm transition-all duration-300">
            <div class="w-12 h-12 rounded-full bg-gold/10 text-gold-amber flex items-center justify-center mb-3">
              <!-- Diamond Icon -->
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2.7 10.3a2.41 2.41 0 0 0 0 3.41l7.59 7.59a2.41 2.41 0 0 0 3.41 0l7.59-7.59a2.41 2.41 0 0 0 0-3.41l-7.59-7.59a2.41 2.41 0 0 0-3.41 0Z"/>
              </svg>
            </div>
            <h3 class="font-sans text-xs sm:text-sm font-semibold text-navy leading-snug">
              Creative<br/>Decor Designs
            </h3>
          </div>

          <!-- Pillar 2: Experienced Team -->
          <div class="flex flex-col items-center text-center p-4 rounded-xl bg-ivory-light border border-beige/80 hover:border-gold/40 shadow-sm transition-all duration-300">
            <div class="w-12 h-12 rounded-full bg-gold/10 text-gold-amber flex items-center justify-center mb-3">
              <!-- Experienced Team Icon -->
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
            </div>
            <h3 class="font-sans text-xs sm:text-sm font-semibold text-navy leading-snug">
              Experienced<br/>Team
            </h3>
          </div>

          <!-- Pillar 3: Quality Materials -->
          <div class="flex flex-col items-center text-center p-4 rounded-xl bg-ivory-light border border-beige/80 hover:border-gold/40 shadow-sm transition-all duration-300">
            <div class="w-12 h-12 rounded-full bg-gold/10 text-gold-amber flex items-center justify-center mb-3">
              <!-- Quality Materials Gear/Flower Icon -->
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16Z"/>
                <path d="M12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
              </svg>
            </div>
            <h3 class="font-sans text-xs sm:text-sm font-semibold text-navy leading-snug">
              Quality<br/>Materials
            </h3>
          </div>

          <!-- Pillar 4: Customer Satisfaction -->
          <div class="flex flex-col items-center text-center p-4 rounded-xl bg-ivory-light border border-beige/80 hover:border-gold/40 shadow-sm transition-all duration-300">
            <div class="w-12 h-12 rounded-full bg-gold/10 text-gold-amber flex items-center justify-center mb-3">
              <!-- Heart Icon -->
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
              </svg>
            </div>
            <h3 class="font-sans text-xs sm:text-sm font-semibold text-navy leading-snug">
              Customer<br/>Satisfaction
            </h3>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>
