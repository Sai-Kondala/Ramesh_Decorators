---
import Layout from '../layouts/Layout.astro';
import { galleryCategories, galleryItems } from '../data/gallery';
import { businessConfig, getWhatsAppUrl } from '../data/business';

// Serialize items for the clientside lightbox & filtering script
const galleryItemsJson = JSON.stringify(galleryItems);
---

<Layout 
  title={`Gallery & Portfolio — ${businessConfig.name}`}
  description="Explore our portfolio of grand wedding mandaps, engagement stages, birthday galas, and corporate event decorations."
  currentPage="/gallery"
>
  <!-- Gallery Page Hero Banner -->
  <section class="relative py-16 sm:py-24 bg-navy text-white overflow-hidden">
    <div class="absolute inset-0 opacity-15 bg-[radial-gradient(#DFB774_1px,transparent_1px)] [background-size:20px_20px]"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gold/15 border border-gold/30 text-gold-light text-xs font-semibold uppercase tracking-[0.2em] mb-4">
        <span>Portfolio Showcase</span>
      </div>
      
      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white mb-4">
        Explore Our Work
      </h1>
      
      <p class="font-sans text-base sm:text-lg text-ivory/80 max-w-2xl mx-auto leading-relaxed">
        From enchanting mandaps and dreamy floral walkways to vibrant birthday themes and grand corporate galas, explore our handcrafted event décors.
      </p>
    </div>
  </section>

  <!-- Interactive Filter Bar & Gallery Grid -->
  <section class="py-12 sm:py-20 bg-ivory min-h-[60vh]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Category Filter Pills -->
      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 mb-10 sm:mb-14" id="filter-pill-container" role="tablist" aria-label="Event categories">
        {galleryCategories.map((cat) => (
          <button
            type="button"
            role="tab"
            data-filter={cat.id}
            class={`gallery-filter-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-gold ${
              cat.id === 'all'
                ? 'active-filter bg-navy text-white shadow-md'
                : 'bg-beige/40 text-navy hover:bg-beige hover:text-navy border border-beige-dark/40'
            }`}
          >
            {cat.label}
          </button>
        ))}
      </div>

      <!-- Live Count Status -->
      <div class="flex items-center justify-between mb-8 pb-4 border-b border-beige/80 text-xs sm:text-sm text-body/80">
        <p>Showing <span id="gallery-count" class="font-bold text-navy">{galleryItems.length}</span> curated designs</p>
        <span class="text-xs text-gold-dark font-medium hidden sm:inline">Click any image to view details</span>
      </div>

      <!-- Gallery Grid -->
      <div 
        id="gallery-grid" 
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 transition-opacity duration-300"
      >
        {galleryItems.map((item, index) => (
          <article
            class="gallery-card group relative bg-ivory rounded-2xl overflow-hidden border border-beige/80 hover:border-gold/50 shadow-sm hover:shadow-luxury-hover transition-all duration-300 flex flex-col cursor-pointer"
            data-category={item.category}
            data-index={index}
            tabindex="0"
            role="button"
            aria-label={`View details for ${item.title}`}
          >
            <!-- Image Aspect Box -->
            <div class="relative aspect-[16/11] overflow-hidden bg-navy/10">
              <img
                src={item.image}
                alt={item.alt}
                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-navy/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-5">
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-gold text-white text-xs font-semibold shadow-md">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"/>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    <line x1="11" y1="8" x2="11" y2="14"/>
                    <line x1="8" y1="11" x2="14" y2="11"/>
                  </svg>
                  <span>View Stage</span>
                </span>
              </div>

              <!-- Top Category Tag -->
              <div class="absolute top-3 left-3">
                <span class="px-3 py-1 rounded-full bg-ivory/95 backdrop-blur-md text-navy text-[11px] font-bold tracking-wider uppercase shadow-sm">
                  {item.categoryLabel}
                </span>
              </div>
            </div>

            <!-- Card Meta Text -->
            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="font-serif text-lg font-bold text-navy group-hover:text-gold-dark transition-colors mb-1.5">
                  {item.title}
                </h3>
                <p class="font-sans text-xs sm:text-sm text-body/80 line-clamp-2 leading-relaxed">
                  {item.description}
                </p>
              </div>

              <div class="mt-4 pt-3 border-t border-beige/60 flex items-center justify-between text-xs text-gold-dark font-semibold">
                <span>Inspect Details</span>
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- No items found state (hidden by default) -->
      <div id="no-items-msg" class="hidden text-center py-20">
        <p class="font-serif text-2xl text-navy font-semibold mb-2">No setups found in this category</p>
        <p class="font-sans text-sm text-body">Please select another category above to view our work.</p>
      </div>

    </div>
  </section>

  <!-- Gallery Lightbox Modal Dialog -->
  <dialog 
    id="lightbox-dialog" 
    class="lightbox-dialog fixed inset-0 m-auto z-50 w-full max-w-5xl max-h-[92vh] p-0 bg-transparent rounded-2xl overflow-hidden focus:outline-none"
    aria-label="Image Preview Dialog"
  >
    <div class="relative bg-ivory rounded-2xl overflow-hidden shadow-2xl border border-beige flex flex-col lg:flex-row max-h-[90vh]">
      
      <!-- Close Button -->
      <button
        type="button"
        id="lightbox-close-btn"
        class="absolute top-4 right-4 z-20 p-2.5 rounded-full bg-navy/80 hover:bg-navy text-white backdrop-blur-md transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-gold"
        aria-label="Close dialog (Escape)"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>

      <!-- Lightbox Main Image Display -->
      <div class="relative flex-1 bg-navy-deep min-h-[300px] sm:min-h-[440px] flex items-center justify-center overflow-hidden">
        <img
          id="lightbox-img"
          src=""
          alt=""
          class="max-h-[70vh] lg:max-h-[85vh] w-full object-contain transition-all duration-300"
        />

        <!-- Previous Button -->
        <button
          type="button"
          id="lightbox-prev-btn"
          class="absolute left-3 top-1/2 -translate-y-1/2 p-3 rounded-full bg-navy/70 hover:bg-navy text-white backdrop-blur-md border border-white/10 hover:border-gold transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-gold"
          aria-label="Previous image (Left Arrow)"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
        </button>

        <!-- Next Button -->
        <button
          type="button"
          id="lightbox-next-btn"
          class="absolute right-3 top-1/2 -translate-y-1/2 p-3 rounded-full bg-navy/70 hover:bg-navy text-white backdrop-blur-md border border-white/10 hover:border-gold transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-gold"
          aria-label="Next image (Right Arrow)"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </button>
      </div>

      <!-- Lightbox Sidebar / Details -->
      <div class="w-full lg:w-80 p-6 sm:p-8 flex flex-col justify-between bg-ivory overflow-y-auto">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span id="lightbox-category" class="px-3 py-1 rounded-full bg-gold/15 text-gold-dark text-xs font-bold uppercase tracking-wider">
              Category
            </span>
            <span id="lightbox-counter" class="text-xs text-body/60 font-medium">1 / 16</span>
          </div>

          <h2 id="lightbox-title" class="font-serif text-2xl font-bold text-navy mb-3">
            Setup Title
          </h2>

          <p id="lightbox-desc" class="font-sans text-sm text-body leading-relaxed mb-6">
            Setup description and styling notes.
          </p>
        </div>

        <div class="pt-6 border-t border-beige/80">
          <p class="text-xs text-body/70 mb-3">Love this decor setup for your event?</p>
          <a
            id="lightbox-enquire-btn"
            href="/contact"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 bg-gradient-to-r from-gold via-gold-amber to-gold-dark text-white text-xs sm:text-sm font-semibold rounded-full shadow-md hover:shadow-luxury-hover hover:scale-[1.02] active:scale-[0.98] transition-all"
          >
            <!-- WhatsApp Icon -->
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
            </svg>
            <span>Enquire on WhatsApp</span>
          </a>
        </div>
      </div>

    </div>
  </dialog>

  <!-- Bottom CTA Callout -->
  <section class="py-16 bg-beige/40 border-t border-beige/60">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-navy mb-3">
        Have a Specific Theme or Mandap Idea in Mind?
      </h2>
      <p class="font-sans text-sm sm:text-base text-body mb-6 max-w-xl mx-auto">
        We specialize in bespoke stage decor tailored to your color palette, venue architecture, and personal taste.
      </p>
      <a
        href="/contact"
        class="inline-flex items-center gap-2 px-7 py-3 bg-navy hover:bg-navy-light text-white text-sm font-semibold rounded-full shadow-md hover:shadow-lg transition-all"
      >
        <span>Request Custom Decor Quote</span>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </a>
    </div>
  </section>
</Layout>

<script define:vars={{ items: galleryItems, whatsappNumber: businessConfig.whatsapp.number }}>
  function initGallery() {
    const filterBtns = document.querySelectorAll('.gallery-filter-btn');
    const cards = document.querySelectorAll('.gallery-card');
    const countDisplay = document.getElementById('gallery-count');
    const noItemsMsg = document.getElementById('no-items-msg');

    const dialog = document.getElementById('lightbox-dialog');
    const closeBtn = document.getElementById('lightbox-close-btn');
    const prevBtn = document.getElementById('lightbox-prev-btn');
    const nextBtn = document.getElementById('lightbox-next-btn');
    const lbImg = document.getElementById('lightbox-img');
    const lbTitle = document.getElementById('lightbox-title');
    const lbDesc = document.getElementById('lightbox-desc');
    const lbCat = document.getElementById('lightbox-category');
    const lbCounter = document.getElementById('lightbox-counter');
    const lbEnquire = document.getElementById('lightbox-enquire-btn');

    let currentFilter = 'all';
    let visibleIndices = items.map((_, i) => i);
    let currentLightboxIdx = 0;

    // Read URL query parameter for category (e.g. ?category=weddings)
    const urlParams = new URLSearchParams(window.location.search);
    const initialCategory = urlParams.get('category');
    if (initialCategory && ['weddings', 'engagements', 'birthdays', 'corporate'].includes(initialCategory)) {
      setFilter(initialCategory);
    }

    function setFilter(filter) {
      currentFilter = filter;
      visibleIndices = [];

      // Update button styling
      filterBtns.forEach((btn) => {
        const cat = btn.getAttribute('data-filter');
        if (cat === filter) {
          btn.classList.add('active-filter', 'bg-navy', 'text-white', 'shadow-md');
          btn.classList.remove('bg-beige/40', 'text-navy', 'border-beige-dark/40');
        } else {
          btn.classList.remove('active-filter', 'bg-navy', 'text-white', 'shadow-md');
          btn.classList.add('bg-beige/40', 'text-navy', 'border-beige-dark/40');
        }
      });

      // Filter cards
      let visibleCount = 0;
      cards.forEach((card, idx) => {
        const cardCat = card.getAttribute('data-category');
        if (filter === 'all' || cardCat === filter) {
          card.classList.remove('hidden');
          visibleIndices.push(idx);
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (countDisplay) countDisplay.textContent = String(visibleCount);

      if (noItemsMsg) {
        if (visibleCount === 0) {
          noItemsMsg.classList.remove('hidden');
        } else {
          noItemsMsg.classList.add('hidden');
        }
      }
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-filter') || 'all';
        setFilter(cat);
      });
    });

    // Lightbox Controls
    function openLightbox(itemIndex) {
      const item = items[itemIndex];
      if (!item || !dialog || !lbImg || !lbTitle || !lbDesc || !lbCat || !lbCounter || !lbEnquire) return;

      currentLightboxIdx = itemIndex;

      lbImg.src = item.image;
      lbImg.alt = item.alt;
      lbTitle.textContent = item.title;
      lbDesc.textContent = item.description;
      lbCat.textContent = item.categoryLabel;

      // Find position within visible items
      const pos = visibleIndices.indexOf(itemIndex);
      const currentPos = pos >= 0 ? pos + 1 : 1;
      lbCounter.textContent = `${currentPos} / ${visibleIndices.length}`;

      // WhatsApp link with prefilled enquiry about this specific setup
      const prefillMsg = encodeURIComponent(
        `Hello Ramesh Decorators, I saw the "${item.title}" (${item.categoryLabel}) on your website and would like to know pricing and availability.`
      );
      lbEnquire.href = `https://wa.me/${whatsappNumber}?text=${prefillMsg}`;

      // Prevent background scrolling
      document.body.style.overflow = 'hidden';

      dialog.showModal();
    }

    function closeLightbox() {
      if (!dialog) return;
      document.body.style.overflow = '';
      dialog.close();
    }

    function showPrev() {
      if (visibleIndices.length === 0) return;
      const currentPos = visibleIndices.indexOf(currentLightboxIdx);
      const prevPos = (currentPos - 1 + visibleIndices.length) % visibleIndices.length;
      openLightbox(visibleIndices[prevPos]);
    }

    function showNext() {
      if (visibleIndices.length === 0) return;
      const currentPos = visibleIndices.indexOf(currentLightboxIdx);
      const nextPos = (currentPos + 1) % visibleIndices.length;
      openLightbox(visibleIndices[nextPos]);
    }

    // Attach click to cards
    cards.forEach((card) => {
      const idx = Number(card.getAttribute('data-index'));
      card.addEventListener('click', () => openLightbox(idx));
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openLightbox(idx);
        }
      });
    });

    closeBtn?.addEventListener('click', closeLightbox);
    prevBtn?.addEventListener('click', showPrev);
    nextBtn?.addEventListener('click', showNext);

    // Light dismiss when clicking backdrop
    dialog?.addEventListener('click', (e) => {
      const rect = dialog.getBoundingClientRect();
      const isInDialog = (
        rect.top <= e.clientY &&
        e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX &&
        e.clientX <= rect.left + rect.width
      );
      if (!isInDialog) {
        closeLightbox();
      }
    });

    // Keyboard navigation
    window.addEventListener('keydown', (e) => {
      if (!dialog?.open) return;
      if (e.key === 'ArrowLeft') {
        showPrev();
      } else if (e.key === 'ArrowRight') {
        showNext();
      } else if (e.key === 'Escape') {
        closeLightbox();
      }
    });

    // Mobile touch swipe gestures
    let touchStartX = 0;
    dialog?.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    dialog?.addEventListener('touchend', (e) => {
      const touchEndX = e.changedTouches[0].screenX;
      const diffX = touchEndX - touchStartX;
      if (diffX > 50) {
        showPrev(); // Swiped right -> go to previous
      } else if (diffX < -50) {
        showNext(); // Swiped left -> go to next
      }
    }, { passive: true });
  }

  initGallery();
  document.addEventListener('astro:page-load', initGallery);
</script>
