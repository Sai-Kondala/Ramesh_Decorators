---
import Layout from '../layouts/Layout.astro';
import HeroCurtain from '../components/HeroCurtain.astro';
import ServiceCard from '../components/ServiceCard.astro';
import GalleryPreview from '../components/GalleryPreview.astro';
import AboutSection from '../components/AboutSection.astro';
import { businessConfig, getWhatsAppUrl, getPhoneTelUrl } from '../data/business';

const services = [
  {
    title: 'Wedding Decorations',
    description: 'Grand & elegant wedding setups tailored to your style.',
    icon: 'mandap' as const,
    href: '/gallery?category=weddings',
  },
  {
    title: 'Engagements',
    description: 'Beautiful décors to celebrate your new beginning.',
    icon: 'rings' as const,
    href: '/gallery?category=engagements',
  },
  {
    title: 'Birthday Events',
    description: 'Creative themes for memorable birthday celebrations.',
    icon: 'cake' as const,
    href: '/gallery?category=birthdays',
  },
  {
    title: 'Corporate Events',
    description: 'Professional event setups for corporate gatherings.',
    icon: 'corporate' as const,
    href: '/gallery?category=corporate',
  },
];
---

<Layout currentPage="/">
  <!-- 1. Hero Section with Interactive String Curtain Reveal -->
  <HeroCurtain />

  <!-- 2. Services Grid Section -->
  <section id="services" class="py-16 sm:py-24 bg-ivory">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Title Header -->
      <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
        <p class="font-sans text-xs sm:text-sm font-bold tracking-[0.22em] text-gold-amber uppercase mb-2">
          WHAT WE DO
        </p>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-navy tracking-tight">
          Signature Decoration Services
        </h2>
        <div class="w-16 h-1 bg-gold mx-auto mt-4 rounded-full"></div>
      </div>

      <!-- 4 Service Cards Grid (Matching the reference design) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-6 lg:gap-8">
        {services.map((service) => (
          <ServiceCard
            title={service.title}
            description={service.description}
            icon={service.icon}
            href={service.href}
          />
        ))}
      </div>

    </div>
  </section>

  <!-- 3. Curated Gallery Preview Section -->
  <GalleryPreview />

  <!-- 4. About Section with 4 Pillars -->
  <AboutSection />

  <!-- 5. Elegant Pre-Footer Call to Action Banner -->
  <section class="py-16 bg-gradient-to-r from-navy-deep via-navy to-navy-light text-white relative overflow-hidden border-t border-gold/40">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#DFB774_1px,transparent_1px)] [background-size:16px_16px]"></div>
    
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="font-sans text-xs sm:text-sm font-bold tracking-[0.22em] text-gold-light uppercase mb-3">
        START PLANNING YOUR EVENT
      </p>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-5 tracking-tight">
        Ready to Transform Your Celebration Into an Unforgettable Experience?
      </h2>
      <p class="font-sans text-base sm:text-lg text-ivory/80 max-w-2xl mx-auto mb-8 leading-relaxed">
        Get in touch with our team today to discuss your date, theme, and bespoke stage decoration requirements.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6">
        <a
          href="/contact"
          class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-gradient-to-r from-gold via-gold-amber to-gold-dark text-white font-semibold rounded-full shadow-lg hover:shadow-luxury-hover hover:scale-[1.02] active:scale-[0.98] transition-all duration-200"
        >
          <span>Book a Free Consultation</span>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </a>

        <a
          href={getWhatsAppUrl("Hello Ramesh Decorators, I want to inquire about availability for an upcoming event.")}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 px-6 py-3.5 bg-white/10 hover:bg-white/20 text-white border border-white/20 hover:border-gold-light font-semibold rounded-full backdrop-blur-sm transition-all duration-200"
        >
          <!-- WhatsApp Icon -->
          <svg class="w-5 h-5 text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
          </svg>
          <span>WhatsApp Chat</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
